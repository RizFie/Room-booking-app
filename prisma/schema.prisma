generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model booking {
  bookingId    Int            @unique(map: "bookingId") @default(autoincrement())
  startTime    DateTime       @db.Time(0)
  endTime      DateTime       @db.Time(0)
  date         DateTime       @db.Date
  purpose      String         @db.VarChar(255)
  userId       Int
  placeId      Int
  place        place          @relation(fields: [placeId], references: [placeId], onUpdate: Restrict, map: "booking_ibfk_1")
  user         user           @relation(fields: [userId], references: [userId], onUpdate: Restrict, map: "booking_ibfk_2")
  cancellation cancellation[]

  @@id([bookingId, placeId, userId])
  @@index([placeId], map: "placeId")
  @@index([userId], map: "userId")
}

model cancellation {
  cancelId   Int      @unique(map: "cancelId") @default(autoincrement())
  reason     String   @db.VarChar(255)
  cancelDate DateTime @db.Date
  userId     Int
  bookingId  Int
  booking    booking  @relation(fields: [bookingId], references: [bookingId], onUpdate: Restrict, map: "cancellation_ibfk_1")
  user       user     @relation(fields: [userId], references: [userId], onUpdate: Restrict, map: "cancellation_ibfk_2")

  @@id([cancelId, userId, bookingId])
  @@index([bookingId], map: "bookingId")
  @@index([userId], map: "userId")
}

model place {
  placeId       Int       @id @unique(map: "placeId") @default(autoincrement())
  placeName     String    @db.VarChar(255)
  placeDesc     String    @db.VarChar(255)
  placeCapacity Int
  placeType     String    @db.VarChar(255)
  booking       booking[]
  picture       picture[]
}

model user {
  userId       Int            @id @unique(map: "userId") @default(autoincrement())
  fullname     String         @db.VarChar(255)
  email        String         @unique @db.VarChar(255)
  password     String         @db.VarChar(255)
  phoneNum     String         @db.VarChar(255)
  role         String         @default("user") @db.VarChar(255)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  booking      booking[]
  cancellation cancellation[]
}

model verificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
  @@map("verificationtokens")
}

model picture {
  picId   Int    @id @default(autoincrement())
  picLink String @db.VarChar(255)
  placeId Int
  place   place  @relation(fields: [placeId], references: [placeId], onUpdate: Restrict, map: "picture_ibfk_1")

  @@index([placeId], map: "placeId")
}