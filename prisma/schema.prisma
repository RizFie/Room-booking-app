generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model booking {
  bookingId    String         @unique(map: "bookingId") @default(uuid())
  startTime    DateTime       @db.Time(0)
  endTime      DateTime       @db.Time(0)
  date         DateTime       @db.Date
  purpose      String         @db.VarChar(255)
  confirmed    Boolean        @default(false)
  userId       String
  placeId      String
  place        place          @relation(fields: [placeId], references: [placeId], onUpdate: Restrict, map: "booking_ibfk_1")
  user         user           @relation(fields: [userId], references: [userId], onUpdate: Restrict, map: "booking_ibfk_2")
  cancellation cancellation[]

  @@id([bookingId, placeId, userId])
  @@index([placeId], map: "placeId")
  @@index([userId], map: "userId")
}

model cancellation {
  cancelId   String   @unique(map: "cancelId") @default(uuid())
  reason     String   @db.VarChar(255)
  cancelDate DateTime @db.Date
  userId     String
  bookingId  String
  booking    booking  @relation(fields: [bookingId], references: [bookingId], onUpdate: Restrict, map: "cancellation_ibfk_1")
  user       user     @relation(fields: [userId], references: [userId], onUpdate: Restrict, map: "cancellation_ibfk_2")

  @@id([cancelId, userId, bookingId])
  @@index([bookingId], map: "bookingId")
  @@index([userId], map: "userId")
}

model place {
  placeId       String    @id @unique(map: "placeId") @default(uuid())
  placeName     String    @db.VarChar(255)
  placeDesc     String    @db.VarChar(500)
  placeCapacity Int
  placeType     String    @db.VarChar(255)
  booking       booking[]
  picture       picture[]
}

model user {
  userId       String         @id @unique(map: "userId") @default(uuid())
  fullname     String         @db.VarChar(255)
  email        String         @unique @db.VarChar(255)
  password     String         @db.VarChar(255)
  phoneNum     String         @db.VarChar(255)
  role         String         @default("user") @db.VarChar(255)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  booking      booking[]
  cancellation cancellation[]
}

model verificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
  @@map("verificationtokens")
}

model picture {
  picId   String @id @default(uuid())
  picLink String @db.VarChar(255)
  placeId String
  place   place  @relation(fields: [placeId], references: [placeId], onUpdate: Restrict, map: "picture_ibfk_1")

  @@index([placeId], map: "placeId")
}
